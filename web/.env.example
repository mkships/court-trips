# Copy to .env.local for local work. In Vercel, set the NEXT_PUBLIC_ ones under
# Project → Settings → Environment Variables (all environments).

# Vercel Blob store token. Only needed on your machine, to run `npm run photos:upload`.
BLOB_READ_WRITE_TOKEN=

# Where photos are served from in production; `npm run photos:upload` prints it.
# Leave empty locally to serve photos from public/photos.
NEXT_PUBLIC_PHOTO_BASE_URL=

# The site's public address, used for link-preview images (e.g. https://courttrips.com).
NEXT_PUBLIC_SITE_URL=

# Neon Postgres (listings and clicks). Set by the Neon integration in Vercel. Locally, use the
# `dev` branch: `npx neon checkout dev` in web/ fills these in. Don't use `vercel env pull` for them.
# The site needs them to show listings; then run `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# "List your program" (see README → Operator submissions). Production refuses to build without the
# first four. Elsewhere, blank Turnstile keys mean Cloudflare's always-pass test keys, and a blank
# Resend key means the notification is logged instead of emailed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
SUBMISSIONS_NOTIFY_TO=
# A sender on a domain verified in Resend; until then onboarding@resend.dev only reaches your own Resend address.
RESEND_FROM=

# Admin (see README → Admin). Not needed locally: `npm run dev` offers a development-only sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGIN=
ADMIN_SESSION_SECRET=

# Harvest (see README → Harvest). The database harvest:import updates: production's, so drafts reach
# /admin. Kept apart from DATABASE_URL above, which local development points at the dev branch.
HARVEST_DATABASE_URL=
