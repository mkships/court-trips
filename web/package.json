{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --env-file-if-exists=.env.local scripts/migrate.mjs && node --env-file-if-exists=.env.local scripts/db-seed.mjs --if-empty && next build",
    "start": "next start",
    "lint": "eslint",
    "photos:upload": "node scripts/photo-variants.mjs && node --env-file-if-exists=.env.local scripts/upload-photos.mjs",
    "photos:prepare": "node scripts/photo-variants.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.mjs",
    "db:studio": "drizzle-kit studio",
    "harvest:fetch": "node --env-file-if-exists=.env.local scripts/harvest/fetch.mjs",
    "harvest:page": "node scripts/harvest/page.mjs",
    "harvest:check": "node scripts/harvest/check.mjs",
    "harvest:archived": "node --env-file-if-exists=.env.local scripts/harvest/archived.mjs",
    "harvest:import": "node --env-file-if-exists=.env.local scripts/harvest/import.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "country-flag-icons": "^1.6.20",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
